# URL de tu proyecto de Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Service Role Key (Settings > API > service_role)
# Nunca la expongas en el cliente ni la subas a Git.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Minutos de validez del QR/codigo
CLASE_EXPIRA_MINUTOS=5

# Secreto para firmar la cookie de sesión. Usá un texto largo y aleatorio,
# por ejemplo el resultado de: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=cambiame-por-un-texto-largo-y-aleatorio
